; Engine configuration file.
; The Last Settlement
; DPN Technology

config_version=5

[application]

config/name="The Last Settlement"
config/version="1.0.5"
config/description="A DPN Technology post-collapse civilization recovery simulation with secure in-game Windows update checks and verified installer handoff."
config/icon="res://assets/app/the-last-settlement-icon.svg"
run/main_scene="res://src/Main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
; Full 3D rendering (Vulkan Forward+) for lit environments and PBR assets.
; Older hardware can launch the compatibility fallback with
; --rendering-method gl_compatibility (see Windows playtest guide).
textures/default_filters/use_nearest_mipmap_filter=false

[environment]

defaults/default_clear_color=Color(0.035, 0.038, 0.043, 1)


[dpn_update]

auto_check=true
channel="stable"
manifest_url="https://github.com/DPN-Technology/The-Last-Settlement/releases/latest/download/windows-release.json"
