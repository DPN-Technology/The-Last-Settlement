class_name GroundAppearance
extends RefCounted

# Deterministic locally baked texture. Unlike the former spatial fragment
# shader, this remains visible through Forward+ and GL Compatibility renderers.
# It does not depend on external services, GPU shader noise, or player files.
const TEXTURE_SIZE := 384
const SEED := 738119

static func bake_image() -> Image:
	var image := Image.create(TEXTURE_SIZE, TEXTURE_SIZE, false, Image.FORMAT_RGB8)
	var broad := FastNoiseLite.new()
	broad.seed = SEED
	broad.frequency = 0.012
	broad.fractal_octaves = 3
	var gravel := FastNoiseLite.new()
	gravel.seed = SEED + 17
	gravel.frequency = 0.085
	gravel.fractal_octaves = 3
	var speckles := FastNoiseLite.new()
	speckles.seed = SEED + 231
	speckles.frequency = 0.37
	for y in range(TEXTURE_SIZE):
		for x in range(TEXTURE_SIZE):
			var high := broad.get_noise_2d(float(x), float(y)) * 0.5 + 0.5
			var medium := gravel.get_noise_2d(float(x), float(y)) * 0.5 + 0.5
			var fine := speckles.get_noise_2d(float(x), float(y)) * 0.5 + 0.5
			var wear := smoothstep(0.45, 0.79, high)
			# Exposed clay, sun-bleached gravel and eroded stone establish
			# larger readable patterns instead of one uniform brown surface.
			var dark := Color("#39332c")
			var clay := Color("#806b55")
			var stony := Color("#a0927a")
			var base := dark.lerp(clay, 0.24 + high * 0.55)
			base = base.lerp(stony, medium * 0.27)
			base = base.darkened(wear * 0.12)
			var mineral := smoothstep(0.74, 0.92, fine) * 0.17
			var sediment := smoothstep(0.58, 0.84, medium) * 0.09
			base = base.lightened(mineral + sediment)
			image.set_pixel(x, y, base)
	image.generate_mipmaps()
	return image

static func bake() -> ImageTexture:
	return ImageTexture.create_from_image(bake_image())

# Height-derived tangent-space bump. Fully baked offline at startup and
# supported by Godot's GL Compatibility path without procedural fragment noise.
static func bake_normal_image(albedo: Image) -> Image:
	var normal := Image.create(TEXTURE_SIZE,TEXTURE_SIZE,false,Image.FORMAT_RGB8)
	for y in range(TEXTURE_SIZE):
		for x in range(TEXTURE_SIZE):
			var l: float=albedo.get_pixel(maxi(0,x-1),y).get_luminance()
			var r: float=albedo.get_pixel(mini(TEXTURE_SIZE-1,x+1),y).get_luminance()
			var up: float=albedo.get_pixel(x,maxi(0,y-1)).get_luminance()
			var down: float=albedo.get_pixel(x,mini(TEXTURE_SIZE-1,y+1)).get_luminance()
			var n := Vector3((l-r)*3.4,(up-down)*3.4,1.0).normalized()
			normal.set_pixel(x,y,Color(n.x*0.5+0.5,n.y*0.5+0.5,n.z*0.5+0.5))
	normal.generate_mipmaps()
	return normal

static func new_ground_material() -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	var color_image := bake_image()
	# The reference is photographic dirt/rock, not a low-resolution noise
	# checker. Prefer the pinned CC0 Poly Haven 1K gravel PBR provided by
	# the Windows build; preserve baked fallback for offline source checkouts.
	var diffuse_path := "res://assets/3d/pbr/gravel_ground_01_diff_1k.png"
	var normal_path := "res://assets/3d/pbr/gravel_ground_01_nor_gl_1k.png"
	var photo_ready: bool=ResourceLoader.exists(diffuse_path) and ResourceLoader.exists(normal_path)
	if photo_ready:
		var photo_diffuse := load(diffuse_path) as Texture2D
		var photo_normal := load(normal_path) as Texture2D
		if photo_diffuse!=null and photo_normal!=null:
			mat.albedo_texture=photo_diffuse
			mat.normal_texture=photo_normal
		else:
			mat.albedo_texture=ImageTexture.create_from_image(color_image)
			mat.normal_texture=ImageTexture.create_from_image(bake_normal_image(color_image))
	else:
		mat.albedo_texture=ImageTexture.create_from_image(color_image)
		mat.normal_texture=ImageTexture.create_from_image(bake_normal_image(color_image))
	mat.normal_enabled=true
	mat.normal_scale=0.80
	mat.albedo_color = Color("#e1d7c6")
	mat.vertex_color_use_as_albedo = true
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	mat.uv1_scale = Vector3.ONE
	mat.roughness = 0.97
	mat.metallic = 0.0
	# The terrain is generated by SurfaceTool triangles. Godot's frontend
	# winding/culling varies with viewing side; double-sided rendering prevents
	# an invisible floor from exposing the much brighter procedural sky.
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	return mat

static func new_ground_failsafe_material() -> StandardMaterial3D:
	# Underlay is intentionally unshaded/dark. If terrain fails to render for
	# any renderer, the player sees solid ground instead of sky-colored void.
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color("#302e28")
	mat.roughness = 1.0
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	return mat

static func sample_luminance(img: Image) -> float:
	if img == null:
		return -1.0
	var sum := 0.0
	var count := 0
	for y in range(0, img.get_height(), 16):
		for x in range(0, img.get_width(), 16):
			var c := img.get_pixel(x, y)
			sum += c.r * 0.2126 + c.g * 0.7152 + c.b * 0.0722
			count += 1
	return sum / maxf(1.0, float(count))
